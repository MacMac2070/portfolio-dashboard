# Live credential. Holds the IBKR Flex Web Service token — never commit this.
# config.local.json.example is the tracked template.
dashboard/config.local.json

# Rebuildable caches. directory.sqlite3 is a ~2.6 MB symbol cache regenerated by
# `adapter/directory.py`; the -shm/-wal sidecars are SQLite's own WAL files and
# are meaningless outside a live connection.
dashboard/data/directory.sqlite3
dashboard/data/directory.sqlite3-shm
dashboard/data/directory.sqlite3-wal
# The daily-close cache adapter/quotes.py keeps: rebuilt from the providers,
# never the only copy of anything.
dashboard/data/quotes.sqlite3
dashboard/data/quotes.sqlite3-shm
dashboard/data/quotes.sqlite3-wal

__pycache__/
*.py[cod]

.DS_Store
.claude/settings.local.json

# Expense tracker (isolated module): live credentials and the local database.
expense-tracker/.env.expense-tracker
expense-tracker/data/
expense-tracker/logs/

# Runtime logs — regenerated every run, never history.
dashboard/logs/
