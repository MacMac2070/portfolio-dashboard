# Live credential. Holds the IBKR Flex Web Service token — never commit this.
# config.local.json.example is the tracked template.
dashboard/config.local.json

# Account data never enters this repository. Everything the adapter writes
# into dashboard/data/ (the JSONL ledgers, the EOD and portfolio snapshots,
# the SQLite caches and their -shm/-wal sidecars) is either the owner's real
# account history or rebuildable from the providers. The repository ships
# only the mock dataset: CSVs under dashboard/data/mock/ and the generator in
# dashboard/scripts/ that turns them into the files the app reads. Real
# ledgers are backed up outside git (they are the only copy of history older
# than the 365 days Flex will re-serve).
dashboard/data/*
!dashboard/data/mock/
!dashboard/data/README.md

# Review screenshots show real account values; they stay local. The design
# loop is described in dashboard/README.md and CLAUDE.md instead.
screenshots/
dashboard/screenshots/

# Earnings reports and factsheets gathered for the held names are third-party
# documents. They stay local and never enter this repository.
Stock research/

# graphify knowledge graph: regenerable with `graphify update .`, and its
# sidecars carry absolute local paths.
graphify-out/

__pycache__/
*.py[cod]

.DS_Store
.claude/settings.local.json

# Expense tracker (isolated module): live credentials and the local database.
expense-tracker/.env.expense-tracker
expense-tracker/data/
expense-tracker/logs/

# Runtime logs — regenerated every run, never history.
dashboard/logs/

# Tool caches.
.ruff_cache/
.pytest_cache/
