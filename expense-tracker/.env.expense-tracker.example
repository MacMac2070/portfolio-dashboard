# Copy to .env.expense-tracker (gitignored) and fill in. This module's config
# only — nothing here is read by the portfolio dashboard.

AGGREGATOR_PROVIDER=          # "enable_banking" or "yapily"
AGGREGATOR_CLIENT_ID=
AGGREGATOR_CLIENT_SECRET=
AGGREGATOR_REDIRECT_URI=http://127.0.0.1:5180/oauth/callback

# Windows box Ollama, same instance Agent 2 uses. Blank = categorisation
# quietly skipped (nulls heal on a later run).
OLLAMA_HOST=

# For the LATER Supabase/Vercel migration — unused while local-first.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
